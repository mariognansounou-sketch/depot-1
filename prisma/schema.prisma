// ============================================================================
// AdWinner OS — Database Schema
// ----------------------------------------------------------------------------
// Designed so every module (Winner Finder, Competitor Intelligence AI,
// Product Validator, Creative Analyzer, Offer Builder, Audience Finder,
// Angle Finder, Script Generator, Copywriter, Comment Analyzer, WhatsApp
// Assistant, Supplier Finder, Ecommerce Brain, Saturation Detector, Market
// Opportunity Score) owns its own tables and can evolve independently
// without breaking the others. Foreign keys are optional wherever a module
// can be used standalone (e.g. an Ad without a linked Product).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH & ACCOUNT
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  image         String?
  role          Role      @default(MEMBER)
  plan          Plan      @default(FREE)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  settings         Settings?
  apiKeys          ApiKey[]
  products         Product[]
  competitors      Competitor[]
  searchHistory    SearchHistory[]
  favorites        Favorite[]
  scriptAssets     ScriptAsset[]
  copyAssets       CopyAsset[]
  creativeAnalyses CreativeAnalysis[]
  whatsappThreads  WhatsAppConversation[]
  memoryEntries    MemoryEntry[]
  notifications    Notification[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum ApiKeyProvider {
  META
  ANTHROPIC
  OPENAI
  TIKTOK
}

/// Encrypted at rest (AES-256-GCM) — see src/infrastructure/security/crypto.ts
model ApiKey {
  id             String         @id @default(cuid())
  userId         String
  provider       ApiKeyProvider
  encryptedValue String         @db.Text
  label          String?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, label])
  @@map("api_keys")
}

model Settings {
  id                String   @id @default(cuid())
  userId            String   @unique
  theme             String   @default("system")
  locale            String   @default("fr")
  defaultCountry    String   @default("BJ")
  notifyByEmail     Boolean  @default(true)
  notifyInApp       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// SHARED / CROSS-MODULE
// ---------------------------------------------------------------------------

model SearchHistory {
  id            String   @id @default(cuid())
  userId        String
  module        String // e.g. "winner-finder", "competitor-analyzer"
  query         Json
  resultSummary String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
  @@map("search_history")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  entityType String // "product" | "ad" | "angle" | "script" | "competitor"
  entityId   String
  note       String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@map("favorites")
}

enum NotificationType {
  NEW_WINNER
  ANALYSIS_READY
  SATURATION_ALERT
  SYSTEM
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// MODULE 1 — WINNER FINDER
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  WATCHING
  TESTING
  WINNER
  LOSER
}

model Product {
  id             String        @id @default(cuid())
  userId         String
  name           String
  category       String?
  description    String?       @db.Text
  priceCost      Float?
  priceSale      Float?
  targetCountry  String?
  status         ProductStatus @default(DRAFT)
  winnerScore    Float?
  opportunity    Float?
  competition    Float?
  launchPotential Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ads                Ad[]
  angles             MarketingAngle[]
  strategies         Strategy[]
  validations        ProductValidation[]
  opportunityScores  MarketOpportunityScore[]
  saturationReports  SaturationReport[]
  offers             Offer[]
  audienceProfiles   AudienceProfile[]
  scriptAssets       ScriptAsset[]
  copyAssets         CopyAsset[]
  creativeAnalyses   CreativeAnalysis[]
  suppliers          Supplier[]

  @@unique([userId, name])
  @@index([userId, status])
  @@map("products")
}

// ---------------------------------------------------------------------------
// MODULE 2 — COMPETITOR INTELLIGENCE AI
// ---------------------------------------------------------------------------

model Competitor {
  id        String   @id @default(cuid())
  userId    String
  name      String
  pageName  String?
  website   String?
  country   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ads  Ad[]

  @@unique([userId, name])
  @@map("competitors")
}

enum AdPlatform {
  META
  TIKTOK
  OTHER
}

enum AdMediaType {
  VIDEO
  IMAGE
  CAROUSEL
  UNKNOWN
}

/// A single ad creative, sourced either from the official Meta Ad Library
/// API (see MetaAdLibraryProvider) or pasted manually by the user
/// (ManualAdInputProvider) when API access is unavailable or the ad is not
/// reachable through the API (see docs/META_AD_LIBRARY.md for the legal
/// rationale behind this dual-source design).
model Ad {
  id              String      @id @default(cuid())
  competitorId    String?
  productId       String?
  sourceArchiveId String? // Meta Ad Library Archive ID
  sourceUrl       String?
  ingestMethod    String      @default("MANUAL") // "META_AD_LIBRARY_API" | "MANUAL"
  platform        AdPlatform  @default(META)
  mediaType       AdMediaType @default(UNKNOWN)
  mediaUrl        String?
  headline        String?
  primaryText     String?     @db.Text
  description     String?     @db.Text
  cta             String?
  countries       String[]    @default([])
  languages       String[]    @default([])
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean     @default(true)
  variantsCount   Int         @default(1)
  rawPayload      Json?
  createdAt       DateTime    @default(now())

  competitor Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  analysis   AdAnalysis?
  comments   CommentAnalysis?

  @@index([competitorId])
  @@index([productId])
  @@map("ads")
}

/// Full AI breakdown of a single ad — hook, structure, angle, emotion,
/// target audience, and a 100-point performance score. See
/// src/modules/competitor-analyzer/use-cases/analyze-competitor.use-case.ts
model AdAnalysis {
  id               String   @id @default(cuid())
  adId             String   @unique
  hookText         String?  @db.Text
  hookScore        Int // /10
  hookReasoning    String   @db.Text
  structure        Json // timeline segments [{ from, to, label, description }]
  angle            String
  angleCategory    String // EMOTIONAL | RATIONAL | SOCIAL | PROBLEM_SOLUTION
  emotion          String
  emotionReasoning String   @db.Text
  targetAudience   Json // { profile, demographics, mainProblem }
  promises         Json // string[]
  benefits         Json // string[]
  objectionsHandled Json // string[]
  performanceScore Int // /100
  scoreBreakdown   Json // { hook, offer, creativity, clarity, cta } each /20
  strengths        Json // string[]
  weaknesses       Json // string[]
  improvements     Json // string[]
  createdAt        DateTime @default(now())

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@map("ad_analyses")
}

model CommentAnalysis {
  id          String   @id @default(cuid())
  adId        String   @unique
  questions   Json // string[]
  objections  Json // string[]
  motivations Json // string[]
  createdAt   DateTime @default(now())

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@map("comment_analyses")
}

enum AngleCategory {
  EMOTIONAL
  RATIONAL
  SOCIAL
  PROBLEM_SOLUTION
}

enum CompetitionLevel {
  LOW
  MEDIUM
  HIGH
}

/// Used both by Module 2 (angles detected in competitor ads) and Module 3
/// (AI Angle Marketing Finder — generated, not-yet-used angles).
model MarketingAngle {
  id                 String           @id @default(cuid())
  productId          String
  name               String
  category           AngleCategory
  description        String           @db.Text
  whyItWorks         String           @db.Text
  targetClient       String
  strengthScore      Int // /100
  competitionLevel   CompetitionLevel
  opportunityScore   Int // /100
  isUsedByCompetitor Boolean          @default(false)
  createdAt          DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("marketing_angles")
}

/// The "better strategy" generated after analyzing one or more competitors.
model Strategy {
  id           String   @id @default(cuid())
  productId    String
  positioning  String   @db.Text
  hooks        Json // string[]
  videoScript  Json // structured script segments
  adCopy       Json // { headline, primaryText, description, cta }
  basedOnAdIds Json // string[] of Ad ids used as input
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("strategies")
}

// ---------------------------------------------------------------------------
// MODULE 5 — PRODUCT VALIDATOR
// ---------------------------------------------------------------------------

enum LaunchDecision {
  LAUNCH
  TEST
  AVOID
}

model ProductValidation {
  id                String         @id @default(cuid())
  productId         String
  demandScore       Int // /20
  competitionScore  Int // /20
  marginScore       Int // /20
  logisticsScore    Int // /20
  adPotentialScore  Int // /20
  totalScore        Int // /100
  decision          LaunchDecision
  reasoning         String         @db.Text
  createdAt         DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_validations")
}

// ---------------------------------------------------------------------------
// MODULE 6 — MARKET OPPORTUNITY SCORE
// ---------------------------------------------------------------------------

model MarketOpportunityScore {
  id                     String   @id @default(cuid())
  productId              String
  country                String
  successElsewhereScore Int // /20
  localCompetitionScore  Int // /20
  purchasingPowerScore   Int // /20
  culturalFitScore       Int // /20
  logisticsScore         Int // /20
  totalScore             Int // /100
  message                String   @db.Text
  createdAt              DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("market_opportunity_scores")
}

// ---------------------------------------------------------------------------
// MODULE 7 — SATURATION DETECTOR
// ---------------------------------------------------------------------------

enum SaturationLevel {
  LOW
  MEDIUM
  HIGH
}

model SaturationReport {
  id                  String          @id @default(cuid())
  productId           String
  advertiserCount     Int
  adGrowthTrend       Json // [{ period, count }]
  avgCampaignDuration Int // days
  storeCount          Int
  saturationLevel     SaturationLevel
  saturationPercent   Int // 0-100
  recommendation      String          @db.Text
  createdAt           DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("saturation_reports")
}

// ---------------------------------------------------------------------------
// MODULE 4 — CREATIVE ANALYZER
// ---------------------------------------------------------------------------

enum CreativeSourceType {
  VIDEO
  IMAGE
}

model CreativeAnalysis {
  id                 String             @id @default(cuid())
  userId             String
  productId          String?
  sourceType         CreativeSourceType
  mediaUrl           String? // null when analyzed from a manual text description only (video fallback)
  hookAttentionScore Int // /10
  structure          Json
  visualAnalysis     Json
  persuasionAnalysis Json
  strengths          Json
  weaknesses         Json
  improvements       Json
  createdAt          DateTime           @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("creative_analyses")
}

// ---------------------------------------------------------------------------
// MODULE 8/9 — SCRIPT GENERATOR & COPYWRITER
// ---------------------------------------------------------------------------

enum ScriptType {
  UGC
  STORYTELLING
  DEMO
}

enum ScriptTone {
  EMOTIONAL
  RATIONAL
  AGGRESSIVE
  SHORT
  LONG
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  WHATSAPP
}

model ScriptAsset {
  id        String     @id @default(cuid())
  userId    String
  productId String?
  type      ScriptType
  tone      ScriptTone
  platform  Platform
  content   Json
  createdAt DateTime   @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("script_assets")
}

enum CopyChannel {
  FACEBOOK_ADS
  WHATSAPP
  SHOPIFY
  TIKTOK
}

model CopyAsset {
  id        String      @id @default(cuid())
  userId    String
  productId String?
  channel   CopyChannel
  content   Json
  createdAt DateTime    @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("copy_assets")
}

// ---------------------------------------------------------------------------
// MODULE 10 — OFFER BUILDER
// ---------------------------------------------------------------------------

model Offer {
  id               String   @id @default(cuid())
  productId        String
  recommendedPrice Float
  reasoning        String   @db.Text
  bonuses          Json
  guarantees       Json
  urgency          Json
  packs            Json
  socialProof      Json
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("offers")
}

// ---------------------------------------------------------------------------
// MODULE 11 — AUDIENCE FINDER
// ---------------------------------------------------------------------------

model AudienceProfile {
  id             String   @id @default(cuid())
  productId      String
  idealClient    Json
  demographics   Json
  motivations    Json
  interests      Json
  behaviors      Json
  lookalikeNotes String?  @db.Text
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("audience_profiles")
}

// ---------------------------------------------------------------------------
// MODULE 14 — SUPPLIER FINDER
// ---------------------------------------------------------------------------

enum SupplierPlatform {
  ALIEXPRESS
  ALIBABA
  CJ_DROPSHIPPING
  OTHER
}

model Supplier {
  id           String           @id @default(cuid())
  productId    String
  name         String
  platform     SupplierPlatform
  price        Float?
  minOrderQty  Int?
  deliveryDays Int?
  rating       Float?
  url          String?
  notes        String?          @db.Text
  createdAt    DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// MODULE 13 — WHATSAPP SALES ASSISTANT
// ---------------------------------------------------------------------------

enum ProspectStatus {
  HOT
  WARM
  HESITANT
  COLD
}

model WhatsAppConversation {
  id                String         @id @default(cuid())
  userId            String
  contactName       String?
  messages          Json // [{ from, text, timestamp }]
  prospectStatus    ProspectStatus @default(WARM)
  detectedObjections Json
  suggestedReplies  Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_conversations")
}

// ---------------------------------------------------------------------------
// MODULE 15 — PERSONAL ECOMMERCE BRAIN
// ---------------------------------------------------------------------------

enum MemoryCategory {
  PRODUCT
  CREATIVE
  ANGLE
  BUDGET
  RESULT
}

model MemoryEntry {
  id        String         @id @default(cuid())
  userId    String
  category  MemoryCategory
  payload   Json
  insight   String?        @db.Text
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@map("memory_entries")
}
