# ============================================================================
# AdWinner OS — Environment variables
# Copy this file to .env.local and fill in real values. Never commit secrets.
# ============================================================================

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adwinner_os"

# --- Auth (Auth.js / NextAuth v5) ----------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- AI Provider (Anthropic Claude) --------------------------------------
# Powers every analysis / generation engine (competitor analysis, angle
# finder, script generator, copywriter, offer builder, audience finder...).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Meta Ad Library API (official, ToS-compliant) ------------------------
# Required to search ads through Meta's official Ad Library API
# (Graph API /ads_archive endpoint). Create a Meta App, request Ad Library
# API access, and generate a long-lived token. See docs/META_AD_LIBRARY.md.
# Without this, the Competitor Analyzer and Winner Finder fall back to the
# manual-input source (users paste ad data directly — always legal, no
# scraping involved).
META_AD_LIBRARY_ACCESS_TOKEN=""
META_GRAPH_API_VERSION="v20.0"

# --- Security --------------------------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- App -------------------------------------------------------------------
NODE_ENV="development"
